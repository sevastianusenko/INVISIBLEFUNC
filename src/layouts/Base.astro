---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, localBusinessSchema } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD graphs for this page (Service, FAQPage, etc.). */
  schema?: Record<string, unknown>[];
}

const { title, description, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const graphs = [localBusinessSchema, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#d5d1c7" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* TODO(content): add og:image once real photography exists — see PHOTOS-NEEDED.md */}

    <link
      rel="preload"
      href="/fonts/archivo-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      graphs.map((g) => (
        <script type="application/ld+json" set:html={JSON.stringify(g)} />
      ))
    }

    {/* Set before first paint so the reveal system never flashes. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveals. One observer, one class, one curve — the same
      // panel/seam vocabulary the hero states on load.
      const nodes = document.querySelectorAll('[data-rv]');
      const open = (el: Element) => el.classList.add('is-open');

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              open(e.target);
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        nodes.forEach((n) => io.observe(n));

        // Safety net: if anything goes wrong, content must not stay concealed.
        window.setTimeout(() => nodes.forEach(open), 3000);
      } else {
        nodes.forEach(open);
      }
    </script>
  </body>
</html>
