---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Seam from '../components/Seam.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { faqSchema } from '../lib/schema';

const ranges = [
  {
    t: 'Installation as a subcontract',
    fig: '$600–2,000',
    unit: 'per mechanism',
    b: 'You supply the mechanism and the millwork. I set it, shim it, wire it, commission it and make good where it meets the building.',
    up: 'Ceiling work, cross-joist framing, a second story, a mechanism I have not worked with before, or a finished room that has to be protected and reinstated.',
    down: 'Ground floor, open framing, a mechanism from a manufacturer I know, and a cabinet built to the dimensions I asked for.',
  },
  {
    t: 'Lift cabinet, built and installed',
    fig: '$6,000–12,000',
    unit: 'complete',
    b: 'Shop-built cabinet, console or ceiling closure with the mechanism supplied, fitted, wired and finished on site. The most common whole-scope job.',
    up: 'Veneer or a matched stain, a mechanism above about 150 lb capacity, a lid that has to move on the same cycle, stone or a specialty top, and any ceiling installation.',
    down: 'Paint grade, a straightforward column lift, a cabinet against a wall rather than freestanding, and an install during construction rather than after it.',
  },
  {
    t: 'Hidden bookcase or jib door',
    fig: 'from $8,500',
    unit: 'per opening',
    b: 'Structural leaf, pivot or concealed hinge hardware, latching, casework, and an even reveal on all four sides — including the adjustment visit after the first heating season.',
    up: 'A loaded bookcase over about 350 lb, a leaf that has to carry stone or glass, matching an existing panelled wall, an opening that was framed to the wrong dimension, and any electric release.',
    down: 'A flush painted panel rather than a bookcase, a plumb and square rough opening built to my dimension, and a wall finish that is being applied after I am done.',
  },
  {
    t: 'Invisible speakers',
    fig: '$3,000–10,000',
    unit: 'per room, as an add-on',
    b: 'Drivers, back-boxing, isolation detailing, skim coat and level-5 finish. Priced as an add-on because it is far cheaper while a wall is already open.',
    up: 'More than four drivers, a ceiling rather than a wall, an occupied and finished room, a flat paint that will show everything, and subwoofer integration.',
    down: 'Two drivers, walls already open, and finishing done in the same visit as other work in the room.',
  },
  {
    t: 'Service and adjustment',
    fig: '$150–250',
    unit: 'per hour',
    b: 'Diagnosis, adjustment, repair and re-commissioning — on my work or on somebody else’s, including mechanisms installed by a contractor who is no longer around.',
    up: 'An unknown mechanism with no documentation, a cavity that has to be opened to reach anything, and travel beyond the core service area.',
    down: 'A mechanism I installed, anything still under manufacturer warranty, and adjustments bundled into a visit I am making anyway.',
  },
];

const excluded = [
  'The display, projector, screen fabric, sources, amplification and control system',
  'Line-voltage electrical work that requires a licensed electrician',
  'Structural alterations that need an engineer’s stamp or a permit',
  'Painting beyond making good the area I disturbed',
  'Stone, glass and specialty tops, which are supplied by their own trades',
];

const faqs = [
  {
    q: 'Why publish prices at all?',
    a: 'Because almost nobody in this niche does, and the silence is not protecting the client. A homeowner who wants to know whether a hidden bookcase door is a $3,000 idea or a $30,000 idea currently has to sit through two showroom appointments to find out. Publishing the range means the people who call are the people the range suits.',
  },
  {
    q: 'Is the range a quote?',
    a: 'No. It is what similar work costs, honestly stated, so you can decide whether to keep reading. An actual quote follows a measurement, names the mechanism and the model number, and holds for 30 days.',
  },
  {
    q: 'What if my project is above the top of a range?',
    a: 'Then I will say so early and tell you why. Larger millwork packages, multi-room scopes and anything involving structural change are quoted individually — the ranges above describe single mechanisms and single openings.',
  },
  {
    q: 'Do you charge for the initial visit?',
    a: 'No, within the core service area, for a visit that is about a real project with a real timeline. Beyond that, or for a measured survey of an existing installation that somebody else built, the hourly service rate applies and I will say so before I drive out.',
  },
  {
    q: 'What are the payment terms?',
    a: 'Homeowners: fifty percent at order to cover the mechanism and materials, the balance on completion. Trade accounts: fifty percent at order, net 15 on the balance. Install-only subcontracts are invoiced on completion at net 30.',
  },
  {
    q: 'Do prices include a warranty?',
    a: 'Manufacturer warranty on the mechanism, passed through in full with the paperwork. Two years on my labour, the millwork and the finish work. The adjustment visit after the first heating season is part of the price, not a warranty claim.',
  },
];
---

<Base
  title="Published price ranges | Invisible Function"
  description="Real price ranges for TV lifts, lift cabinets, hidden doors, invisible speakers and service calls — plus what moves a project inside each range."
  schema={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow="Pricing"
    lines={['Numbers,', 'before you', 'have to call']}
    lead="Almost nobody in this trade publishes a price. That is a decision made for the seller, not the buyer. Here is what work like this actually costs, and what moves a project to the top or the bottom of each range."
  >
    <div class="hero__reveal" style="margin-top:1.9rem">
      <div class="btn-row" style="--d:860ms">
        <a class="btn" href="/contact/">
          Get an actual quote
          <span class="btn__tick" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </PageHero>

  <!-- ── The ranges ───────────────────────────────────────────────────────── -->
  <section class="section surface-paper">
    <div class="wrap">
      <Seam />
      <div class="rail" style="margin-top:clamp(2rem,4vw,3.5rem)">
        <p class="label rail__label">Ranges</p>
        <div>
          <div data-rv="lift"><h2 class="h2">Five ways this work gets bought</h2></div>
          <p class="lead soft" style="margin-top:1.1rem;max-width:56ch">
            Figures are for southeastern Pennsylvania and assume a single mechanism
            or a single opening. They include my labour, the millwork and the
            finish work where it meets the building.
          </p>

          <div class="stack" style="--gap:1rem;margin-top:clamp(1.75rem,3.5vw,2.5rem)">
            {
              ranges.map((r, i) => (
                <article class="panel" data-rv="leaf" style={`--rv-d:${i * 65}ms`}>
                  <div class="card__head">
                    <span class="panel__index">{String(i + 1).padStart(2, '0')}</span>
                    <span class="price__fig" style="text-align:right">
                      {r.fig}
                      <span class="price__unit">{r.unit}</span>
                    </span>
                  </div>
                  <h3 class="h3" style="margin-top:.6rem">{r.t}</h3>
                  <p class="soft" style="margin-top:.75rem;max-width:64ch">{r.b}</p>

                  <div class="pair" style="margin-top:1.5rem">
                    <div>
                      <p class="label">Pushes it up</p>
                      <p style="margin-top:.5rem;font-size:.95rem;line-height:1.55">{r.up}</p>
                    </div>
                    <div>
                      <p class="label">Keeps it down</p>
                      <p style="margin-top:.5rem;font-size:.95rem;line-height:1.55">{r.down}</p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Not included ─────────────────────────────────────────────────────── -->
  <section class="section surface-dark">
    <div class="wrap">
      <Seam />
      <div class="rail" style="margin-top:clamp(2rem,4vw,3.5rem)">
        <p class="label rail__label label--accent">Not in the number</p>
        <div>
          <div data-rv="lift"><h2 class="h2">What the ranges do not cover</h2></div>
          <p class="lead soft" style="margin-top:1.1rem;max-width:56ch">
            Stated here rather than discovered later. Any of these can be
            coordinated; none of them are inside the figures above.
          </p>
          <ul class="ticks" style="margin-top:1.6rem;max-width:62ch">
            {excluded.map((e) => <li>{e}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────────── -->
  <section class="section surface-light">
    <div class="wrap">
      <Seam />
      <div class="rail" style="margin-top:clamp(2rem,4vw,3.5rem)">
        <p class="label rail__label">Questions</p>
        <div>
          <div data-rv="lift"><h2 class="h2">About the money</h2></div>
          <div style="margin-top:clamp(1.5rem,3vw,2.25rem)">
            <Faq items={faqs} id="pricing" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Cta
    title="A quote costs you one email"
    body="Measured, mechanism named, model number given, held for 30 days. If your project does not suit the ranges on this page, that answer comes back just as fast."
    secondary={{ href: '/for-trade/', label: 'Trade terms' }}
  />
</Base>
