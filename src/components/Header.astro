---
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="hdr">
  <div class="wrap hdr__bar">
    <a class="mark" href="/" aria-label={`${site.name} — home`}>
      <span class="mark__glyph" aria-hidden="true"></span>
      <span class="mark__name">Invisible Function</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            class="nav__link"
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        class="nav__link nav__link--promoted"
        href="/contact/"
        aria-current={isCurrent('/contact/') ? 'page' : undefined}
      >
        Contact
      </a>
      <a class="btn nav__cta" href="/contact/">
        Request a quote
        <span class="btn__tick" aria-hidden="true"></span>
      </a>
    </nav>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="menu-sheet"
      data-menu-btn
    >
      <span class="menu-btn__bars" aria-hidden="true"><i></i><i></i></span>
      <span data-menu-label>Menu</span>
    </button>
  </div>
</header>

<!-- The mobile menu drops in from the ceiling on the same curve as everything
     else on the site. It is a panel, not a drawer. -->
<div class="sheet" id="menu-sheet" data-menu-sheet hidden>
  <div class="wrap">
    <ul class="sheet__list">
      {
        nav.map((item) => (
          <li>
            <a
              class="sheet__link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
              <span>{item.href.replace(/\/$/, '') || '/'}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="sheet__link" href="/contact/">
          Contact<span>/contact</span>
        </a>
      </li>
    </ul>
    <div class="sheet__foot" style="padding-bottom:.5rem">
      <a class="btn" href="/contact/">
        Request a quote
        <span class="btn__tick" aria-hidden="true"></span>
      </a>
      <p class="label">{site.city}, {site.regionName} — {site.email}</p>
    </div>
  </div>
</div>
<div class="scrim" data-menu-scrim hidden></div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const sheet = document.querySelector<HTMLElement>('[data-menu-sheet]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const scrim = document.querySelector<HTMLElement>('[data-menu-scrim]');

  if (btn && sheet && label && scrim) {
    // `hidden` keeps the panel out of the tab order for no-JS readers too;
    // it is removed on first paint so the transition has something to run on.
    sheet.hidden = false;
    scrim.hidden = false;

    let open = false;

    const set = (next: boolean) => {
      open = next;
      sheet.classList.toggle('is-open', open);
      scrim.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Menu';
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) sheet.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    btn.addEventListener('click', () => set(!open));
    scrim.addEventListener('click', () => { set(false); btn.focus(); });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        set(false);
        btn.focus();
      }
    });

    // Anything that moves focus outside the open panel closes it.
    document.addEventListener('focusin', (e) => {
      const t = e.target as Node;
      if (open && !sheet.contains(t) && t !== btn) set(false);
    });

    const wide = window.matchMedia('(min-width: 1024px)');
    wide.addEventListener('change', (e) => {
      if (e.matches && open) set(false);
    });
  }
</script>
